[Unit]
Description=World Cup Data REST API
After=network.target mysql.service

[Service]
Type=simple
User=worldcup
Group=worldcup
WorkingDirectory=/opt/worldcup
EnvironmentFile=/opt/worldcup/.env
ExecStartPre=/opt/worldcup/.venv/bin/python -m alembic upgrade head
ExecStart=/opt/worldcup/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
